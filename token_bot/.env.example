# Salin menjadi token_bot/.env (JANGAN di-commit; sudah di .gitignore). chmod 600 token_bot/.env
# 1) Token bot Telegram dari @BotFather
TELEGRAM_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 2) chat_id kamu (python -m token_bot chat-id setelah /start). Bot hanya menerima perintah dari chat pribadi ini.
TELEGRAM_CHAT_ID=123456789
# 3) Harga saham acuan (opsional, untuk token saham): Twelve Data (paket gratis)
TWELVEDATA_API_KEY=
# Bot TIDAK memakai private key dan tidak mengirim transaksi. JANGAN pernah menaruh private key di file ini.
