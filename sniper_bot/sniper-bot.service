# systemd (Linux VPS): sudo cp sniper_bot/sniper-bot.service /etc/systemd/system/ ; ubah User & path di bawah
# lalu: sudo systemctl daemon-reload && sudo systemctl enable --now sniper-bot && journalctl -u sniper-bot -f
[Unit]
Description=Sniper bot Telegram
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/Trading
ExecStart=/home/ubuntu/Trading/.venv/bin/python -m sniper_bot jalan
Restart=always
RestartSec=30
UMask=0077
# pengerasan: tidak bisa menaikkan hak akses, sistem file read-only kecuali folder data bot
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/Trading/sniper_bot/data

[Install]
WantedBy=multi-user.target
