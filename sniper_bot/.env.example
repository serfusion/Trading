# Salin menjadi sniper_bot/.env (JANGAN di-commit; sudah di .gitignore). Tanpa tanda kutip.
# Linux: chmod 600 sniper_bot/.env  (hanya kamu yang bisa membaca)
# 1) Token dari @BotFather
TELEGRAM_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 2) user id kamu (python -m sniper_bot chat-id). Bot hanya menerima perintah dari CHAT PRIBADI dengan id ini
#    (grup tidak dilayani). Lebih dari satu orang: pisahkan koma.
TELEGRAM_CHAT_ID=123456789
# 3) Hanya untuk mode live: kunci API bursa HANYA izin trading spot, TANPA withdraw/transfer, whitelist IP server.
BURSA_API_KEY=
BURSA_API_SECRET=
# OKX/KuCoin/Bitget butuh passphrase:
BURSA_API_PASSWORD=
