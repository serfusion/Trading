# Salin menjadi sniper_bot/.env (JANGAN di-commit; sudah di .gitignore). Tanpa tanda kutip.
# 1) Token dari @BotFather
TELEGRAM_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 2) chat_id kamu (python -m sniper_bot chat-id). Lebih dari satu: pisahkan koma.
TELEGRAM_CHAT_ID=123456789
# 3) Hanya untuk mode live: kunci API bursa TANPA izin withdraw, whitelist IP server.
BURSA_API_KEY=
BURSA_API_SECRET=
# OKX/Bitget butuh passphrase:
BURSA_API_PASSWORD=
